<?xml version="1.0" encoding="utf-8"?>
<Project ToolsVersion="4.0" xmlns="http://schemas.microsoft.com/developer/msbuild/2003">
	<!-- Linux x64 native libraries -->
	<ItemGroup Condition="'$(RuntimeIdentifier)' == 'linux-x64' OR ('$(RuntimeIdentifier)' == '' AND '$([System.Runtime.InteropServices.RuntimeInformation]::IsOSPlatform($([System.Runtime.InteropServices.OSPlatform]::Linux)))' == 'true')">
		<None Include="$(MSBuildThisFileDirectory)..\runtimes\linux-x64\native\libscintilla.so" Condition="Exists('$(MSBuildThisFileDirectory)..\runtimes\linux-x64\native\libscintilla.so')">
			<Link>libscintilla.so</Link>
			<CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
		</None>
		<None Include="$(MSBuildThisFileDirectory)..\runtimes\linux-x64\native\liblexilla.so" Condition="Exists('$(MSBuildThisFileDirectory)..\runtimes\linux-x64\native\liblexilla.so')">
			<Link>liblexilla.so</Link>
			<CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
		</None>
		<!-- Fallback to old location for backward compatibility -->
		<None Include="$(MSBuildThisFileDirectory)libscintilla.so" Condition="Exists('$(MSBuildThisFileDirectory)libscintilla.so') AND !Exists('$(MSBuildThisFileDirectory)..\runtimes\linux-x64\native\libscintilla.so')">
			<Link>libscintilla.so</Link>
			<CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
		</None>
		<None Include="$(MSBuildThisFileDirectory)liblexilla.so" Condition="Exists('$(MSBuildThisFileDirectory)liblexilla.so') AND !Exists('$(MSBuildThisFileDirectory)..\runtimes\linux-x64\native\liblexilla.so')">
			<Link>liblexilla.so</Link>
			<CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
		</None>
	</ItemGroup>
	
	<!-- Windows x64 native libraries -->
	<ItemGroup Condition="'$(RuntimeIdentifier)' == 'win-x64' OR ('$(RuntimeIdentifier)' == '' AND '$([System.Runtime.InteropServices.RuntimeInformation]::IsOSPlatform($([System.Runtime.InteropServices.OSPlatform]::Windows)))' == 'true' AND '$([System.Runtime.InteropServices.RuntimeInformation]::ProcessArchitecture)' == 'X64')">
		<None Include="$(MSBuildThisFileDirectory)..\runtimes\win-x64\native\scintilla.dll" Condition="Exists('$(MSBuildThisFileDirectory)..\runtimes\win-x64\native\scintilla.dll')">
			<Link>scintilla.dll</Link>
			<CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
		</None>
		<None Include="$(MSBuildThisFileDirectory)..\runtimes\win-x64\native\lexilla.dll" Condition="Exists('$(MSBuildThisFileDirectory)..\runtimes\win-x64\native\lexilla.dll')">
			<Link>lexilla.dll</Link>
			<CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
		</None>
	</ItemGroup>
	
	<!-- Windows x86 native libraries -->
	<ItemGroup Condition="'$(RuntimeIdentifier)' == 'win-x86' OR ('$(RuntimeIdentifier)' == '' AND '$([System.Runtime.InteropServices.RuntimeInformation]::IsOSPlatform($([System.Runtime.InteropServices.OSPlatform]::Windows)))' == 'true' AND '$([System.Runtime.InteropServices.RuntimeInformation]::ProcessArchitecture)' == 'X86')">
		<None Include="$(MSBuildThisFileDirectory)..\runtimes\win-x86\native\scintilla.dll" Condition="Exists('$(MSBuildThisFileDirectory)..\runtimes\win-x86\native\scintilla.dll')">
			<Link>scintilla.dll</Link>
			<CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
		</None>
		<None Include="$(MSBuildThisFileDirectory)..\runtimes\win-x86\native\lexilla.dll" Condition="Exists('$(MSBuildThisFileDirectory)..\runtimes\win-x86\native\lexilla.dll')">
			<Link>lexilla.dll</Link>
			<CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
		</None>
	</ItemGroup>
	
	<!-- macOS x64 native libraries -->
	<ItemGroup Condition="'$(RuntimeIdentifier)' == 'osx-x64' OR ('$(RuntimeIdentifier)' == 'osx' AND '$([System.Runtime.InteropServices.RuntimeInformation]::ProcessArchitecture)' == 'X64')">
		<None Include="$(MSBuildThisFileDirectory)..\runtimes\osx-x64\native\libscintilla.dylib" Condition="Exists('$(MSBuildThisFileDirectory)..\runtimes\osx-x64\native\libscintilla.dylib')">
			<Link>libscintilla.dylib</Link>
			<CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
		</None>
		<None Include="$(MSBuildThisFileDirectory)..\runtimes\osx-x64\native\liblexilla.dylib" Condition="Exists('$(MSBuildThisFileDirectory)..\runtimes\osx-x64\native\liblexilla.dylib')">
			<Link>liblexilla.dylib</Link>
			<CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
		</None>
	</ItemGroup>
	
	<!-- macOS ARM64 native libraries -->
	<ItemGroup Condition="'$(RuntimeIdentifier)' == 'osx-arm64' OR ('$(RuntimeIdentifier)' == 'osx' AND '$([System.Runtime.InteropServices.RuntimeInformation]::ProcessArchitecture)' == 'Arm64')">
		<None Include="$(MSBuildThisFileDirectory)..\runtimes\osx-arm64\native\libscintilla.dylib" Condition="Exists('$(MSBuildThisFileDirectory)..\runtimes\osx-arm64\native\libscintilla.dylib')">
			<Link>libscintilla.dylib</Link>
			<CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
		</None>
		<None Include="$(MSBuildThisFileDirectory)..\runtimes\osx-arm64\native\liblexilla.dylib" Condition="Exists('$(MSBuildThisFileDirectory)..\runtimes\osx-arm64\native\liblexilla.dylib')">
			<Link>liblexilla.dylib</Link>
			<CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
		</None>
	</ItemGroup>
</Project>