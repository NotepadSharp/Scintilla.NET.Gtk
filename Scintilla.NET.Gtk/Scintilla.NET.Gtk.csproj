<Project Sdk="Microsoft.NET.Sdk">
	<PropertyGroup>
		<TargetFramework>netstandard2.1</TargetFramework>
		<OutputType>Library</OutputType>
		<ImplicitUsings>disable</ImplicitUsings>
		<Nullable>enable</Nullable>
		<AssemblyTitle>Scintilla.NET.Gtk</AssemblyTitle>
		<Company>Jacob Slusser, VPKSoft, cyber960</Company>
		<Product>Scintilla.NET.Gtk</Product>
		<Description>Source Editing Component based on Scintilla 5 series.</Description>
		<Copyright>Copyright © VPKSoft 2023 and Pete Davis 2025.</Copyright>
		<Version>2.0.2</Version>
		<AllowUnsafeBlocks>true</AllowUnsafeBlocks>
		<DocumentationFile>bin\$(Configuration)\Scintilla.NET.Gtk.xml</DocumentationFile>
		<UseWindowsForms>true</UseWindowsForms>
		<OutputPath>bin\$(Configuration)\</OutputPath>
		<LangVersion>latest</LangVersion>
		<RootNamespace>ScintillaNet.Gtk</RootNamespace>
		<GeneratePackageOnBuild>True</GeneratePackageOnBuild>
		<Title>Scintilla.NET.Gtk</Title>
		<PackageProjectUrl>https://github.com/NotepadSharp/Scintilla.NET.Gtk</PackageProjectUrl>
        <PackageId>NotepadSharp.Scintilla.NET.Gtk</PackageId>
		<PackageIcon>NotepadSharp_logo.png</PackageIcon>
		<PackageReadmeFile>README.md</PackageReadmeFile>
		<RepositoryUrl>https://nuget.pkg.github.com/NotepadSharp/index.json</RepositoryUrl>
		<PackageTags>scintilla;gtk;wrapper;source-editing</PackageTags>
		<PackageReleaseNotes>See: https://github.com/NotepadSharp/Scintilla.NET.Gtk</PackageReleaseNotes>
		<PackageLicenseExpression>MIT</PackageLicenseExpression>
		<PackageRequireLicenseAcceptance>True</PackageRequireLicenseAcceptance>
	</PropertyGroup>
	<ItemGroup>
		<PackageReference Include="GtkSharp" Version="3.24.24.38" />
		<PackageReference Include="Scintilla.NET.Abstractions" Version="1.0.11" />
	</ItemGroup>

	<ItemGroup>
		<!-- For the native libraries to embed into NuGet generation -->
		<None Include="..\README.md">
		  <Pack>True</Pack>
		  <PackagePath>\</PackagePath>
		</None>
		<None Include="..\vpksoft_logo.png">
		  <Pack>True</Pack>
		  <PackagePath>\</PackagePath>
		</None>
		<None Include="..\NotepadSharp_logo.png">
		  <Pack>True</Pack>
		  <PackagePath>\</PackagePath>
		</None>
		<None Include="Scintilla.NET.Gtk.targets">
			<PackagePath>build\</PackagePath>
			<Pack>true</Pack>
		</None>
		
		<!-- Linux native libraries (x64) -->
		<None Include="liblexilla.so" Condition="Exists('liblexilla.so')">
			<CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
			<PackagePath>runtimes\linux-x64\native\</PackagePath>
			<Pack>true</Pack>
			<Link>runtimes\linux-x64\native\liblexilla.so</Link>
		</None>
		<None Include="libscintilla.so" Condition="Exists('libscintilla.so')">
			<CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
			<PackagePath>runtimes\linux-x64\native\</PackagePath>
			<Pack>true</Pack>
			<Link>runtimes\linux-x64\native\libscintilla.so</Link>
		</None>
		
		<!-- Windows native libraries (x64) - to be added -->
		<None Include="runtimes\win-x64\native\lexilla.dll" Condition="Exists('runtimes\win-x64\native\lexilla.dll')">
			<CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
			<PackagePath>runtimes\win-x64\native\</PackagePath>
			<Pack>true</Pack>
			<Link>runtimes\win-x64\native\lexilla.dll</Link>
		</None>
		<None Include="runtimes\win-x64\native\scintilla.dll" Condition="Exists('runtimes\win-x64\native\scintilla.dll')">
			<CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
			<PackagePath>runtimes\win-x64\native\</PackagePath>
			<Pack>true</Pack>
			<Link>runtimes\win-x64\native\scintilla.dll</Link>
		</None>
		
		<!-- Windows native libraries (x86) - to be added -->
		<None Include="runtimes\win-x86\native\lexilla.dll" Condition="Exists('runtimes\win-x86\native\lexilla.dll')">
			<CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
			<PackagePath>runtimes\win-x86\native\</PackagePath>
			<Pack>true</Pack>
			<Link>runtimes\win-x86\native\lexilla.dll</Link>
		</None>
		<None Include="runtimes\win-x86\native\scintilla.dll" Condition="Exists('runtimes\win-x86\native\scintilla.dll')">
			<CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
			<PackagePath>runtimes\win-x86\native\</PackagePath>
			<Pack>true</Pack>
			<Link>runtimes\win-x86\native\scintilla.dll</Link>
		</None>
		
		<!-- macOS native libraries (x64) - to be added -->
		<None Include="runtimes\osx-x64\native\liblexilla.dylib" Condition="Exists('runtimes\osx-x64\native\liblexilla.dylib')">
			<CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
			<PackagePath>runtimes\osx-x64\native\</PackagePath>
			<Pack>true</Pack>
			<Link>runtimes\osx-x64\native\liblexilla.dylib</Link>
		</None>
		<None Include="runtimes\osx-x64\native\libscintilla.dylib" Condition="Exists('runtimes\osx-x64\native\libscintilla.dylib')">
			<CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
			<PackagePath>runtimes\osx-x64\native\</PackagePath>
			<Pack>true</Pack>
			<Link>runtimes\osx-x64\native\libscintilla.dylib</Link>
		</None>
		
		<!-- macOS native libraries (arm64) - to be added -->
		<None Include="runtimes\osx-arm64\native\liblexilla.dylib" Condition="Exists('runtimes\osx-arm64\native\liblexilla.dylib')">
			<CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
			<PackagePath>runtimes\osx-arm64\native\</PackagePath>
			<Pack>true</Pack>
			<Link>runtimes\osx-arm64\native\liblexilla.dylib</Link>
		</None>
		<None Include="runtimes\osx-arm64\native\libscintilla.dylib" Condition="Exists('runtimes\osx-arm64\native\libscintilla.dylib')">
			<CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
			<PackagePath>runtimes\osx-arm64\native\</PackagePath>
			<Pack>true</Pack>
			<Link>runtimes\osx-arm64\native\libscintilla.dylib</Link>
		</None>
			<!-- Include native binaries for NuGet packaging and output directory -->
			<None Include="win-x64\ScintillaNET.dll">
				<Pack>true</Pack>
				<PackagePath>runtimes/win-x64/native/</PackagePath>
				<CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
			</None>
			<None Include="linux-x64/libscintilla.so">
				<Pack>true</Pack>
				<PackagePath>runtimes/linux-x64/native/</PackagePath>
				<CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
			</None>
			<!-- Add more platforms as needed -->
	</ItemGroup>
</Project>
